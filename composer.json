{
    "name": "youvision/think-querylist",
    "authors": [
        {
            "name": "indiboy-create",
            "homepage": "https://github.com/indiboy-create"
        },
        {
            "name": "AI",
            "role": "Developer"
        }
    ],
    "description": "ThinkPHP 8 集成 QueryList 的网页采集扩展，支持多采集配置、链式规则与容器注入",
    "type": "library",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "querylist",
        "crawler",
        "spider",
        "scraper"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0",
        "jaeger/querylist": "^4.4",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "topthink/framework": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkQueryList\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkQueryList\\Tests\\": "tests/"
        }
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkQueryList\\Service"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "topthink/think-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}